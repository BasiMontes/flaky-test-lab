{
  "name": "flaky-test-lab",
  "version": "0.1.0",
  "private": true,
  "description": "Laboratorio de flaky tests: catálogo de causas de inestabilidad, reproducción mínima y medición por repetición",
  "scripts": {
    "test": "playwright test",
    "test:a1": "playwright test tests/A1-espera-fija.spec.ts --repeat-each=100 --reporter=line",
    "test:a2": "playwright test tests/A2-carrera-peticion.spec.ts --repeat-each=100 --reporter=line",
    "test:a3": "playwright test tests/A3-timeout-carga.spec.ts --repeat-each=100 --reporter=line",
    "test:a4": "playwright test tests/A4-elemento-que-se-mueve.spec.ts --repeat-each=100 --reporter=line",
    "test:a5": "playwright test tests/A5-rerender-invalida-locator.spec.ts --repeat-each=100 --reporter=line",
    "test:b1": "playwright test tests/B1-estado-compartido.spec.ts --repeat-each=100 --reporter=line",
    "test:c1": "playwright test tests/C1-dependencia-hora.spec.ts --repeat-each=100 --reporter=line",
    "test:c2": "playwright test tests/C2-datos-aleatorios.spec.ts --repeat-each=100 --reporter=line",
    "test:c3": "playwright test tests/C3-api-externa.spec.ts --repeat-each=100 --reporter=line",
    "test:c4": "playwright test tests/C4-tamano-ventana.spec.ts --repeat-each=100 --reporter=line",
    "test:d1": "playwright test tests/D1-aserto-vacio.spec.ts --repeat-each=100 --reporter=line",
    "test:d1:resumen": "node -e \"const fs=require('fs');for(const v of ['debil','solida']){const c={};for(const f of fs.readdirSync('estado/d1').filter(f=>f.startsWith(v+'-'))){const n=fs.readFileSync('estado/d1/'+f,'utf8').trim();c[n]=(c[n]||0)+1}console.log(v,JSON.stringify(c))}\"",
    "test:b2": "playwright test tests/B2-dependencia-orden.spec.ts --repeat-each=100 --reporter=line",
    "test:b2:aislada": "playwright test tests/B2-dependencia-orden.spec.ts -g \"otra prueba\" --repeat-each=100 --reporter=line",
    "test:b2:serie": "playwright test tests/B2-dependencia-orden.spec.ts --workers=1 --repeat-each=100 --reporter=line",
    "test:b3": "playwright test tests/B3-datos-no-unicos.spec.ts --repeat-each=100 --reporter=line",
    "test:b3:serie": "playwright test tests/B3-datos-no-unicos.spec.ts --workers=1 --repeat-each=100 --reporter=line",
    "test:b4": "playwright test tests/B4-estado-navegador.spec.ts --repeat-each=100 --reporter=line",
    "test:b4:aislada": "playwright test tests/B4-estado-navegador.spec.ts -g \"inestable\" --repeat-each=100 --reporter=line",
    "test:b4:serie": "playwright test tests/B4-estado-navegador.spec.ts --workers=1 --repeat-each=100 --reporter=line",
    "test:toolshop": "playwright test -c real-case/toolshop/playwright.config.ts --reporter=list",
    "test:toolshop:100": "playwright test -c real-case/toolshop/playwright.config.ts --repeat-each=100 --reporter=line",
    "test:toolshop:w8": "playwright test -c real-case/toolshop/playwright.config.ts --repeat-each=100 --reporter=line --workers=8",
    "test:toolshop:cpu4": "CPU_THROTTLE=4 playwright test -c real-case/toolshop/playwright.config.ts --repeat-each=100 --reporter=line",
    "test:toolshop:cpu4:1": "CPU_THROTTLE=4 playwright test -c real-case/toolshop/playwright.config.ts --reporter=list",
    "test:toolshop:ingenuas:1": "playwright test -c real-case/toolshop/playwright.ingenuas.config.ts --reporter=list",
    "test:toolshop:ingenuas": "playwright test -c real-case/toolshop/playwright.ingenuas.config.ts --repeat-each=100 --reporter=line",
    "test:toolshop:ingenuas:cpu4": "CPU_THROTTLE=4 playwright test -c real-case/toolshop/playwright.ingenuas.config.ts --repeat-each=100 --reporter=line",
    "test:toolshop:n5:resumen": "node -e \"const fs=require(\\\"fs\\\");const c={};for(const f of fs.readdirSync(\\\"real-case/toolshop/estado/n5\\\")){const n=fs.readFileSync(\\\"real-case/toolshop/estado/n5/\\\"+f,\\\"utf8\\\").trim();c[n]=(c[n]||0)+1}console.log(JSON.stringify(c))\"",
    "test:toolshop:n6c": "playwright test -c real-case/toolshop/playwright.ingenuas.config.ts -g N6c --repeat-each=100 --reporter=line",
    "test:toolshop:n5": "playwright test -c real-case/toolshop/playwright.ingenuas.config.ts -g N5 --repeat-each=100 --reporter=line",
    "test:toolshop:n5:cpu4": "CPU_THROTTLE=4 playwright test -c real-case/toolshop/playwright.ingenuas.config.ts -g N5 --repeat-each=100 --reporter=line",
    "test:toolshop:lat": "playwright test -c real-case/toolshop/playwright.config.ts --repeat-each=100 --reporter=line",
    "test:toolshop:ingenuas:lat": "playwright test -c real-case/toolshop/playwright.ingenuas.config.ts --repeat-each=100 --reporter=line",
    "test:toolshop:pedido:1": "playwright test -c real-case/toolshop/playwright.config.ts -g P7 --reporter=list",
    "test:toolshop:pedido": "playwright test -c real-case/toolshop/playwright.config.ts -g P7 --repeat-each=100 --reporter=line",
    "test:toolshop:ingenuas:pedido": "playwright test -c real-case/toolshop/playwright.ingenuas.config.ts -g \"N7|N8\" --repeat-each=100 --reporter=line",
    "test:toolshop:pedido:300": "playwright test -c real-case/toolshop/playwright.config.ts -g P7 --repeat-each=300 --reporter=line",
    "detectar": "node tools/flaky-detector/detectar.js",
    "test:detector": "node --test tools/flaky-detector/analizar.test.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
